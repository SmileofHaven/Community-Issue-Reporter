diff --git a/docs/ai-triage.md b/docs/ai-triage.md
new file mode 100644
index 0000000..5413af1
--- /dev/null
+++ b/docs/ai-triage.md
@@ -0,0 +1,41 @@
+# AI triage
+
+after POST /api/issues responds, the server asks a vision model to pick category and priority from the title, description and photos
+the crew is derived from the category, so the model can never assign outside the fixed list
+
+## flow
+1. reporter submits a report (photos already uploaded to cloudinary), it is saved as New and the response returns immediately
+2. lib/autoassign.js runs in the background (waitUntil keeps the vercel function alive), the reporter never waits
+3. lib/triage.js calls gemini (4s per model, 8s total, photos fetched from cloudinary as small jpegs) and validates the json against config lists
+4. hazard keywords (live wire, open manhole, gas leak, sinkhole...) force High priority
+5. a low-confidence model (below 0.8) cannot override a category the reporter picked
+6. if a team results, the issue is updated to Assigned with that team, else it stays New (category and priority are still updated)
+7. if an admin already changed the issue meanwhile, the ai result is discarded
+8. any failure or missing key => manual triage, behaviour is unchanged
+
+## env vars
+- GEMINI_API_KEY: enables triage (google ai studio key), leave unset to disable
+- TRIAGE_MODELS: optional comma list tried in order, defaults to gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
+  use free flash models listed in ai studio, a model that errors (503, 429, 404, timeout) falls through to the next
+
+## data
+issues/{id}.ai = { category, priority, reason, confidence } or null
+returned only to admins by GET /api/admin/issues and GET /api/issues/:id
+admins can still override team, priority and status through PATCH /api/issues/:id
+
+## category => team
+- pothole => Roads & Potholes Crew
+- drainage => Drainage Unit
+- streetlight => Electrical Team
+- garbage => Sanitation Dept.
+- water => Water Works
+- other => no team (stays New)
+
+## swapping the provider
+only callModel() in lib/triage.js talks to the provider, it must return the parsed json object or null
+
+## tests
+npm test (tests/triage.test.js uses a mocked model, no network)
+
+## manual check
+GEMINI_API_KEY=your_key node scripts/triage-check.js [image_url]
diff --git a/lib/autoassign.js b/lib/autoassign.js
new file mode 100644
index 0000000..2a6b0d2
--- /dev/null
+++ b/lib/autoassign.js
@@ -0,0 +1,47 @@
+'use strict';
+const { triage } = require('./triage');
+const { getAdmin } = require('./firebase');
+
+// runs after the response is sent => never throws, never blocks the reporter
+async function autoAssign(db, issueId, triageFn) {
+  try {
+    const ref = db.doc('issues/' + issueId);
+    const snap = await ref.get();
+    if (!snap.exists) { return; }
+    const d = snap.data();
+    const ai = await (triageFn || triage)({
+      title: d.title,
+      description: d.description,
+      category: d.category,
+      priority: d.priority,
+      photos: d.photos || []
+    });
+    if (!ai) { return; }
+
+    const Timestamp = getAdmin().firestore.Timestamp;
+    await db.runTransaction(async (tx) => {
+      const cur = await tx.get(ref);
+      if (!cur.exists) { return; }
+      const c = cur.data();
+      // an admin already acted on it => leave their work alone
+      if (c.status !== 'New' || c.team) { return; }
+      const now = Timestamp.now();
+      const upd = {
+        category: ai.category,
+        priority: ai.priority,
+        ai: { category: ai.category, priority: ai.priority, reason: ai.reason, confidence: ai.confidence },
+        updatedAt: now
+      };
+      if (ai.team) {
+        upd.team = ai.team;
+        upd.status = 'Assigned';
+        upd.history = (c.history || []).concat([{ status: 'Assigned', at: now.toDate().toISOString() }]);
+      }
+      tx.update(ref, upd);
+    });
+  } catch (e) {
+    // triage is best effort => report stays as submitted
+  }
+}
+
+module.exports = { autoAssign };
