# Copy to .env for local use (never commit .env). On Vercel, add the same keys under Project Settings -> Environment Variables.

# Firebase service account JSON (Firebase console -> Project settings -> Service accounts -> Generate new private key).
# Must be ONE line: either the raw JSON, or (recommended) the file base64-encoded.
FIREBASE_SERVICE_ACCOUNT=

# Cloudinary (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: comma-separated origins allowed to call the API cross-origin (e.g. local frontend on Live Server).
# Not needed when the frontend is served from the same Vercel project.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
